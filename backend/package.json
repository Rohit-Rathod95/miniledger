{
    "name": "miniledger-backend",
    "version": "1.0.0",
    "private": true,
    "description": "MiniLedger backend - Node.js + TypeScript + Express API backed by PostgreSQL (Supabase).",
    "main": "dist/index.js",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/index.js",
        "migrate": "tsx db/migrate.ts",
        "typecheck": "tsc --noEmit",
        "test": "jest --runInBand"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.45.4",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.21.1",
        "jsonwebtoken": "^9.0.2",
        "multer": "^1.4.5-lts.1",
        "pg": "^8.13.1",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jest": "^29.5.14",
        "@types/jsonwebtoken": "^9.0.7",
        "@types/multer": "^1.4.12",
        "@types/node": "^20.17.6",
        "@types/pg": "^8.11.10",
        "@types/supertest": "^6.0.2",
        "jest": "^29.7.0",
        "supertest": "^7.0.0",
        "ts-jest": "^29.2.5",
        "tsx": "^4.19.2",
        "typescript": "^5.6.3"
    }
}