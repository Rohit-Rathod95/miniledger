# ---- Database ----
# Supabase -> Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/miniledger
# Supabase requires SSL; set true when pointing at Supabase.
PGSSL=false

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# ---- OTP ----
OTP_TTL_MINUTES=5
# Also return the OTP in the request-otp response (handy for demos).
# The OTP is ALWAYS printed to the server log, per the assignment.
EXPOSE_OTP_IN_RESPONSE=true

# ---- Supabase Storage (receipt photos) ----
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=receipts

# ---- Server ----
PORT=4000
